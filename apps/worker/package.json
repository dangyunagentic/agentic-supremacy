{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema ../api/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "../api/prisma/schema.prisma"
  },
  "dependencies": {
    "@mintbot/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.0",
    "ethers": "^6.13.4",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
