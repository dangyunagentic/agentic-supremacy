# ── Database ──
DB_NAME=mintbot
DB_USER=mintbot
DB_PASSWORD=change-me
DATABASE_URL=postgresql://mintbot:change-me@localhost:5432/mintbot

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── API ──
PORT=3001
NODE_ENV=development
JWT_SECRET=generate-a-64-char-hex-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MASTER_KEY=generate-a-32-char-master-key

# ── CORS / reverse-proxy ──
# Comma-separated allowlist of dashboard origins. REQUIRED in production so the
# dashboard can call the API; anything not listed is rejected.
WEB_ORIGIN=http://localhost:3000
# When a reverse proxy (Caddy/nginx) sits in front of the API, set this to the
# proxy's subnet(s) so rate limiting uses the real client IP. NEVER use `true`.
# Example (docker internal network): TRUST_PROXY=172.16.0.0/12
TRUST_PROXY=

# ── Admin bootstrap ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
ADMIN_USERNAME=admin

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
# Polling in dev; set WEBHOOK_URL in production
TELEGRAM_WEBHOOK_URL=

# ── OpenSea (allowlist/FCFS path) ──
OPENSEA_API_KEY=

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# ── First admin Telegram id allowed to claim admin via /start ──
ADMIN_TELEGRAM_ID=
