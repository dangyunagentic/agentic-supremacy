{
  "name": "agentic-supremacy",
  "private": true,
  "version": "0.1.0",
  "description": "NFT Mint Automation Bot - web platform, Telegram bot and execution engine for SeaDrop mints",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:deploy": "pnpm --filter api prisma:deploy",
    "db:studio": "pnpm --filter api prisma:studio",
    "db:seed": "pnpm --filter api prisma:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.15.0"
}
